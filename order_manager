from config import (
    MENU_FILE,
    CUSTOMER_FILE,
    ORDER_FILE,
    ORDER_STATUSES,
    GST_RATE
)
from storage import load_data, save_data
from utils import generate_id, current_datetime, find_by_id, money


def create_order():
    menu = load_data(MENU_FILE)
    customers = load_data(CUSTOMER_FILE)
    orders = load_data(ORDER_FILE)

    if not any(item["available"] for item in menu):
        print("No available menu items.")
        return

    view_customer_option = input(
        "Enter a registered Customer ID, or press Enter for a walk-in: "
    ).strip()

    customer = None

    if view_customer_option:
        customer = find_by_id(
            customers,
            view_customer_option
        )

        if not customer:
            print("Customer not found.")
            return

    items = []

    while True:
        available_items = [
            item for item in menu
            if item["available"]
        ]

        print("\nAvailable items:")

        for item in available_items:
            print(
                item["id"], item["name"],
                money(item["price"])
            )

        food_id = input(
            "\nEnter Food ID, or DONE to finish: "
        ).strip()

        if food_id.upper() == "DONE":
            break

        food = find_by_id(menu, food_id)

        if not food or not food["available"]:
            print("Invalid or unavailable food item.")
            continue

        try:
            quantity = int(input("Quantity: "))

            if quantity <= 0:
                print("Quantity must be positive.")
                continue

        except ValueError:
            print("Enter a valid quantity.")
            continue

        existing = next(
            (entry for entry in items if entry["food_id"] == food_id),
            None
        )

        if existing:
            existing["quantity"] += quantity
        else:
            items.append({
                "food_id": food["id"],
                "name": food["name"],
                "unit_price": food["price"],
                "quantity": quantity
            })

    if not items:
        print("Order cancelled: no items selected.")
        return

    subtotal = round(
        sum(entry["unit_price"] * entry["quantity"] for entry in items),
        2
    )

    tax = round(subtotal * GST_RATE / 100, 2)
    total = round(subtotal + tax, 2)

    order = {
        "id": generate_id("ORD"),
        "customer_id": customer["id"] if customer else None,
        "customer_name": customer["name"] if customer else "Walk-in",
        "items": items,
        "subtotal": subtotal,
        "gst_rate": GST_RATE,
        "gst_amount": tax,
        "total": total,
        "status": "Placed",
        "payment_status": "Pending",
        "created_at": current_datetime()
    }

    orders.append(order)
    save_data(ORDER_FILE, orders)

    print("\nOrder created successfully!")
    print("Order ID:", order["id"])
    print("Subtotal:", money(subtotal))
    print("GST:", money(tax))
    print("Total:", money(total))


def view_orders():
    orders = load_data(ORDER_FILE)

    if not orders:
        print("No orders found.")
        return

    for order in orders:
        print("-" * 45)
        print("Order ID:", order["id"])
        print("Customer:", order["customer_name"])
        print("Status:", order["status"])
        print("Payment:", order["payment_status"])
        print("Total:", money(order["total"]))


def search_order():
    orders = load_data(ORDER_FILE)
    order_id = input("Order ID: ").strip()

    order = find_by_id(orders, order_id)

    if not order:
        print("Order not found.")
        return

    print("\nOrder:", order["id"])
    print("Customer:", order["customer_name"])

    for item in order["items"]:
        print(
            item["name"],
            "x", item["quantity"],
            "=", money(item["unit_price"] * item["quantity"])
        )

    print("Subtotal:", money(order["subtotal"]))
    print("GST:", money(order["gst_amount"]))
    print("Total:", money(order["total"]))
    print("Status:", order["status"])
    print("Payment:", order["payment_status"])


def update_order_status():
    orders = load_data(ORDER_FILE)
    order_id = input("Order ID: ").strip()

    order = find_by_id(orders, order_id)

    if not order:
        print("Order not found.")
        return

    if order["status"] in ("Served", "Cancelled"):
        print("This order is already closed.")
        return

    allowed_next = {
        "Placed": ["Preparing", "Cancelled"],
        "Preparing": ["Ready", "Cancelled"],
        "Ready": ["Served", "Cancelled"]
    }

    choices = allowed_next.get(order["status"], [])

    if not choices:
        print("No status changes available.")
        return

    print("Available next statuses:")

    for index, status in enumerate(choices, 1):
        print(f"{index}. {status}")

    try:
        choice = int(input("Select status: "))

        if not 1 <= choice <= len(choices):
            print("Invalid choice.")
            return

    except ValueError:
        print("Invalid input.")
        return

    new_status = choices[choice - 1]

    if new_status == "Cancelled" and order["payment_status"] == "Paid":
        print("Refund handling is required before cancelling a paid order.")
        return

    order["status"] = new_status
    save_data(ORDER_FILE, orders)

    print("Order status updated.")
